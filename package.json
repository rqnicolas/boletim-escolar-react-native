import {View, Text, TextInput, TouchableOpacity} from 'react-native';
import AntDesign from '@expo/vector-icons/AntDesign';
import {useState} from 'react';
import casca from './css/estilo';

export default function App(){

  const [n1,setN1] = useState();
  const [n2,setN2] = useState();
  const [n3,setN3] = useState();
  const [n4,setN4] = useState();
  const [media,setMedia] = useState();

  function Calcular(){

    var soma = parseInt(n1) + parseInt(n2) + parseInt(n3) + parseInt(n4);
    var resultado = soma / 4;

    setMedia(resultado);

    if(resultado >= 7){
      alert("Aprovado!");
    }else{
      alert("Reprovado!");
    }
  }

  return (
    <View style={casca.container}>

      <Text style={casca.paragraph}>
        Boletim Escolar
      </Text>

      <View style={casca.cx1}>

        <TextInput style={casca.caixas}
          placeholder="Primeira nota"
          value={n1} onChangeText={setN1} />

        <TextInput style={casca.caixas}
          placeholder="Segunda nota"
          value={n2} onChangeText={setN2} />

        <TextInput style={casca.caixas}
          placeholder="Terceira nota"
          value={n3} onChangeText={setN3} />

        <TextInput style={casca.caixas}
          placeholder="Quarta nota"
          value={n4} onChangeText={setN4} />

        <Text style={casca.textotoal}>Média</Text>

        <TextInput style={casca.cxtotal}
          value={media}
          editable={false} />

        <TouchableOpacity style={casca.calculadora} onPress={Calcular}>
          <AntDesign name="calculator" size={24} color="black" />
        </TouchableOpacity>

      </View>
    </View>
  );
}